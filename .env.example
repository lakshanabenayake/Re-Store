# ============================================
# ReStore Environment Variables Template
# ============================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git (it's in .gitignore)

# ============================================
# DATABASE CONFIGURATION
# ============================================
DB_SERVER=db                        # Use 'db' for Docker, or IP for external database
DB_PORT=1433                        # Default SQL Server port (use 1434 if mapped differently)
DB_NAME=RestoreDb                   # Your database name
DB_USER=sa                          # Database username
DB_PASSWORD=YourStrong@Passw0rd     # CHANGE THIS! Strong password required

# ============================================
# CORS CONFIGURATION
# ============================================
CORS_ORIGIN=http://localhost:3000   # For local development
# For production VPS, use:
# CORS_ORIGIN=http://your-vps-ip,http://your-domain.com

# ============================================
# STRIPE PAYMENT GATEWAY
# ============================================
STRIPE_PUBLISHABLE_KEY=pk_test_...  # Your Stripe publishable key
STRIPE_SECRET_KEY=sk_test_...       # Your Stripe secret key
STRIPE_WEBHOOK_SECRET=whsec_...     # Your Stripe webhook secret

# ============================================
# CLOUDINARY IMAGE STORAGE
# ============================================
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ============================================
# GOOGLE GEMINI AI
# ============================================
GEMINI_API_KEY=AIza...              # Your Google Gemini API key for chat & embeddings

# ============================================
# PINECONE VECTOR DATABASE
# ============================================
PINECONE_API_KEY=pcsk_...           # Your Pinecone API key for semantic search

# ============================================
# APPLICATION SETTINGS
# ============================================
ASPNETCORE_ENVIRONMENT=Production   # Development, Production, or Staging
PORT=5000                           # API port (default 5000)

# ============================================
# NEXT.JS CLIENT (VPS only)
# ============================================
NEXT_PUBLIC_API_URL=http://api:5000/api  # For Docker internal network
# For external access:
# NEXT_PUBLIC_API_URL=http://your-vps-ip:5000/api
