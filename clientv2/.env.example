# Example environment variables for production deployment
# Copy this to .env.production and update with your actual values

# API URL - Update this to your actual VPS API URL
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# For production VPS deployment, use your VPS domain:
# NEXT_PUBLIC_API_URL=https://your-vps-domain.com/api
# or
# NEXT_PUBLIC_API_URL=http://your-vps-ip:5000/api
